{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ConsumeAccountRateLimitResetCreditOutcome": {
      "oneOf": [
        {
          "description": "A reset credit was consumed and the eligible rate-limit windows were reset.",
          "enum": [
            "reset"
          ],
          "type": "string"
        },
        {
          "description": "No current rate-limit window is eligible for a reset.",
          "enum": [
            "nothingToReset"
          ],
          "type": "string"
        },
        {
          "description": "The account has no earned reset credits available.",
          "enum": [
            "noCredit"
          ],
          "type": "string"
        },
        {
          "description": "The same idempotency key already completed a reset successfully.",
          "enum": [
            "alreadyRedeemed"
          ],
          "type": "string"
        }
      ]
    },
    "InferenceNativeSource": {
      "enum": [
        "root",
        "imported"
      ],
      "type": "string"
    },
    "UsageResetCompletion": {
      "properties": {
        "accountId": {
          "type": "string"
        },
        "completedAt": {
          "description": "Unix seconds; does not prove present quota or proxy readiness.",
          "format": "int64",
          "type": "integer"
        },
        "completedAtNs": {
          "description": "Decimal Unix nanoseconds preserve ordering within a second without JavaScript integer loss.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/InferenceNativeSource"
        }
      },
      "required": [
        "accountId",
        "completedAt",
        "completedAtNs",
        "id",
        "source"
      ],
      "type": "object"
    }
  },
  "properties": {
    "outcome": {
      "$ref": "#/definitions/ConsumeAccountRateLimitResetCreditOutcome"
    },
    "resetCompletion": {
      "anyOf": [
        {
          "$ref": "#/definitions/UsageResetCompletion"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "outcome"
  ],
  "title": "ConsumeAccountRateLimitResetCreditResponse",
  "type": "object"
}