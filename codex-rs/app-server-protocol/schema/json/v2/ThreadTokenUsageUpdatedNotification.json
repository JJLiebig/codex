{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "InferenceAttribution": {
      "description": "Discovery or the current native login cannot establish which account served a request.",
      "oneOf": [
        {
          "properties": {
            "accountId": {
              "type": "string"
            },
            "displayLabel": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "$ref": "#/definitions/InferenceNativeSource"
            },
            "type": {
              "enum": [
                "servedNative"
              ],
              "title": "ServedNativeInferenceAttributionType",
              "type": "string"
            }
          },
          "required": [
            "accountId",
            "source",
            "type"
          ],
          "title": "ServedNativeInferenceAttribution",
          "type": "object"
        },
        {
          "description": "A matching local cooldown prevented an upstream attempt.",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "displayLabel": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "$ref": "#/definitions/InferenceNativeSource"
            },
            "type": {
              "enum": [
                "intendedNative"
              ],
              "title": "IntendedNativeInferenceAttributionType",
              "type": "string"
            }
          },
          "required": [
            "accountId",
            "source",
            "type"
          ],
          "title": "IntendedNativeInferenceAttribution",
          "type": "object"
        },
        {
          "description": "The frozen inventory proves the provider, without asserting a Claude account identity.",
          "properties": {
            "type": {
              "enum": [
                "claude"
              ],
              "title": "ClaudeInferenceAttributionType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "ClaudeInferenceAttribution",
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "unknown"
              ],
              "title": "UnknownInferenceAttributionType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "UnknownInferenceAttribution",
          "type": "object"
        }
      ]
    },
    "InferenceNativeSource": {
      "enum": [
        "root",
        "imported"
      ],
      "type": "string"
    },
    "ThreadTokenUsage": {
      "properties": {
        "last": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        },
        "modelContextWindow": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "total": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        }
      },
      "required": [
        "last",
        "total"
      ],
      "type": "object"
    },
    "TokenUsageBreakdown": {
      "properties": {
        "cacheWriteInputTokens": {
          "default": 0,
          "format": "int64",
          "type": "integer"
        },
        "cachedInputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "inputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "outputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "reasoningOutputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "totalTokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "cachedInputTokens",
        "inputTokens",
        "outputTokens",
        "reasoningOutputTokens",
        "totalTokens"
      ],
      "type": "object"
    }
  },
  "properties": {
    "inferenceAttribution": {
      "anyOf": [
        {
          "$ref": "#/definitions/InferenceAttribution"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "threadId": {
      "type": "string"
    },
    "tokenUsage": {
      "$ref": "#/definitions/ThreadTokenUsage"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "threadId",
    "tokenUsage",
    "turnId"
  ],
  "title": "ThreadTokenUsageUpdatedNotification",
  "type": "object"
}